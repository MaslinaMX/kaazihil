#!/bin/bash

################################################################################
#                          KAAZIHIL DEPLOY SCRIPT                              #
#                                                                              #
# Propósito: Automaticar el deployment del proyecto a producción (VPS)        #
# Uso: ./deploy [environment]                                                 #
# Ejemplo: ./deploy production                                                #
#                                                                              #
################################################################################

set -e  # Salir si hay error

# ============================================================================
# COLORES PARA SALIDA
# ============================================================================

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# ============================================================================
# FUNCIONES AUXILIARES
# ============================================================================

log_info() {
    echo -e "${BLUE}ℹ ${1}${NC}"
}

log_success() {
    echo -e "${GREEN}✓ ${1}${NC}"
}

log_warning() {
    echo -e "${YELLOW}⚠ ${1}${NC}"
}

log_error() {
    echo -e "${RED}✗ ${1}${NC}"
}

# ============================================================================
# CONFIGURACIÓN INICIAL
# ============================================================================

ENVIRONMENT=${1:-production}
DEPLOYMENT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LOG_FILE="${DEPLOYMENT_DIR}/storage/logs/deploy-$(date +%Y%m%d_%H%M%S).log"

# Verificar que el directorio existe
if [ ! -d "$DEPLOYMENT_DIR" ]; then
    log_error "Directorio de deployment no encontrado: $DEPLOYMENT_DIR"
    exit 1
fi

# ============================================================================
# INICIO DE DEPLOYMENT
# ============================================================================

clear

cat << "EOF"
╔════════════════════════════════════════════════════════════════════════════╗
║                                                                            ║
║                    🚀 KAAZIHIL DEPLOYMENT SCRIPT 🚀                       ║
║                                                                            ║
║                    Laravel 13 + Vite + Bootstrap                          ║
║                                                                            ║
╚════════════════════════════════════════════════════════════════════════════╝
EOF

echo ""
log_info "Iniciando deployment en ambiente: $ENVIRONMENT"
log_info "Directorio: $DEPLOYMENT_DIR"
log_info "Timestamp: $(date)"
log_info "Logs guardados en: $LOG_FILE"
echo ""

# ============================================================================
# 1. VERIFICACIÓN DE REQUISITOS
# ============================================================================

log_info "Verificando requisitos del sistema..."

# Verificar git
if ! command -v git &> /dev/null; then
    log_error "Git no está instalado"
    exit 1
fi
log_success "Git disponible"

# Verificar PHP
if ! command -v php &> /dev/null; then
    log_error "PHP no está instalado"
    exit 1
fi
PHP_VERSION=$(php -v | head -n 1 | grep -oP '(?<=PHP )[0-9]+\.[0-9]+')
log_success "PHP $PHP_VERSION disponible"

# Verificar Composer
if ! command -v composer &> /dev/null; then
    log_error "Composer no está instalado"
    exit 1
fi
log_success "Composer disponible"

# Verificar Node.js y npm
if ! command -v node &> /dev/null; then
    log_error "Node.js no está instalado"
    exit 1
fi
NODE_VERSION=$(node -v)
log_success "Node.js $NODE_VERSION disponible"

if ! command -v npm &> /dev/null; then
    log_error "npm no está instalado"
    exit 1
fi
log_success "npm disponible"

echo ""

# ============================================================================
# 2. VERIFICAR ESTADO DE GIT
# ============================================================================

log_info "Verificando estado del repositorio..."

cd "$DEPLOYMENT_DIR"

# Verificar que estamos en un repositorio git
if [ ! -d .git ]; then
    log_error "No es un repositorio git"
    exit 1
fi
log_success "Repositorio git validado"

# Verificar rama actual
CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)
log_success "Rama actual: $CURRENT_BRANCH"

# Mostrar commits pendientes
UNPUSHED=$(git log --oneline @{u}.. 2>/dev/null | wc -l || echo "0")
if [ "$UNPUSHED" -gt 0 ]; then
    log_warning "Existen $UNPUSHED commits no pusheados"
fi

echo ""

# ============================================================================
# 3. CREAR BACKUP
# ============================================================================

log_info "Creando backup..."

BACKUP_DIR="$DEPLOYMENT_DIR/backups/$(date +%Y%m%d_%H%M%S)"
mkdir -p "$BACKUP_DIR"

# Backup de archivos críticos
if [ -f "$DEPLOYMENT_DIR/.env" ]; then
    cp "$DEPLOYMENT_DIR/.env" "$BACKUP_DIR/.env.backup"
    log_success "Backup de .env creado"
fi

if [ -d "$DEPLOYMENT_DIR/storage" ]; then
    cp -r "$DEPLOYMENT_DIR/storage" "$BACKUP_DIR/storage_backup"
    log_success "Backup de storage creado"
fi

echo ""

# ============================================================================
# 4. ACTUALIZAR CÓDIGO DESDE GIT
# ============================================================================

log_info "Actualizando código desde repositorio..."

# Stash cualquier cambio local sin commit
STASH_COUNT=$(git stash list | wc -l)

git fetch -q origin >> "$LOG_FILE" 2>&1 || {
    log_error "Error en git fetch"
    exit 1
}
log_success "Git fetch completado"

git pull -q origin "$CURRENT_BRANCH" >> "$LOG_FILE" 2>&1 || {
    log_error "Error en git pull"
    exit 1
}
log_success "Código actualizado desde $CURRENT_BRANCH"

# Mostrar últimos commits
log_info "Últimos commits:"
git log --oneline -3

echo ""

# ============================================================================
# 5. INSTALAR DEPENDENCIAS PHP (COMPOSER)
# ============================================================================

log_info "Instalando dependencias PHP con Composer..."

if [ ! -f "$DEPLOYMENT_DIR/composer.lock" ]; then
    log_warning "composer.lock no encontrado, ejecutando composer install"
fi

composer install --no-dev --optimize-autoloader --quiet >> "$LOG_FILE" 2>&1 || {
    log_error "Error en composer install"
    exit 1
}
log_success "Dependencias PHP instaladas"

echo ""

# ============================================================================
# 6. INSTALAR DEPENDENCIAS NODE (NPM)
# ============================================================================

log_info "Instalando dependencias Node.js..."

npm ci --quiet >> "$LOG_FILE" 2>&1 || {
    log_warning "npm ci falló, intentando npm install"
    npm install --quiet >> "$LOG_FILE" 2>&1 || {
        log_error "Error en npm install"
        exit 1
    }
}
log_success "Dependencias Node.js instaladas"

echo ""

# ============================================================================
# 7. BUILD DE ASSETS (VITE)
# ============================================================================

log_info "Compilando assets con Vite..."

npm run build >> "$LOG_FILE" 2>&1 || {
    log_error "Error en npm run build"
    exit 1
}
log_success "Assets compilados exitosamente"

echo ""

# ============================================================================
# 8. CONFIGURACIÓN DE VARIABLES DE ENTORNO
# ============================================================================

log_info "Verificando configuración de entorno..."

if [ ! -f "$DEPLOYMENT_DIR/.env" ]; then
    if [ -f "$DEPLOYMENT_DIR/.env.example" ]; then
        cp "$DEPLOYMENT_DIR/.env.example" "$DEPLOYMENT_DIR/.env"
        log_warning ".env creado desde .env.example"
        log_warning "IMPORTANTE: Actualiza las variables de entorno en .env"
    else
        log_error "No se encontró .env ni .env.example"
        exit 1
    fi
fi

# Generar key de aplicación si no existe
if ! grep -q "APP_KEY=" "$DEPLOYMENT_DIR/.env" || [ -z "$(grep APP_KEY "$DEPLOYMENT_DIR/.env" | cut -d= -f2-)" ]; then
    log_info "Generando APP_KEY..."
    php artisan key:generate --quiet >> "$LOG_FILE" 2>&1 || {
        log_error "Error generando APP_KEY"
        exit 1
    }
    log_success "APP_KEY generada"
fi
log_success "Configuración de entorno validada"

echo ""

# ============================================================================
# 9. MIGRACIONES DE BASE DE DATOS
# ============================================================================

log_info "Ejecutando migraciones de base de datos..."

php artisan migrate --force --quiet >> "$LOG_FILE" 2>&1 || {
    log_warning "Error en migraciones (pueden no existir migraciones pendientes)"
}
log_success "Migraciones completadas"

echo ""

# ============================================================================
# 10. SEEDERS (Opcional)
# ============================================================================

# Descomenta si deseas ejecutar seeders en producción
# log_info "Ejecutando seeders..."
# php artisan db:seed --force --quiet >> "$LOG_FILE" 2>&1
# log_success "Seeders completados"

# ============================================================================
# 11. LIMPIEZA DE CACHÉS
# ============================================================================

log_info "Limpiando cachés..."

php artisan cache:clear --quiet >> "$LOG_FILE" 2>&1 || true
log_success "Caché de aplicación limpiado"

php artisan config:cache --quiet >> "$LOG_FILE" 2>&1 || true
log_success "Caché de configuración regenerado"

php artisan route:cache --quiet >> "$LOG_FILE" 2>&1 || true
log_success "Caché de rutas regenerado"

# php artisan view:cache --quiet >> "$LOG_FILE" 2>&1 || true
# log_success "Caché de vistas regenerado"

echo ""

# ============================================================================
# 12. AJUSTAR PERMISOS
# ============================================================================

log_info "Ajustando permisos de directorios..."

# Permisos para storage
chmod -R 775 "$DEPLOYMENT_DIR/storage" 2>/dev/null || true
chmod -R 775 "$DEPLOYMENT_DIR/bootstrap/cache" 2>/dev/null || true
log_success "Permisos de storage ajustados"

# Si estamos en un usuario web como www-data
if id "www-data" &>/dev/null 2>&1; then
    chown -R www-data:www-data "$DEPLOYMENT_DIR/storage" 2>/dev/null || true
    chown -R www-data:www-data "$DEPLOYMENT_DIR/bootstrap/cache" 2>/dev/null || true
    log_success "Propietario asignado a www-data"
fi

echo ""

# ============================================================================
# 13. VERIFICACIÓN FINAL
# ============================================================================

log_info "Ejecutando verificaciones finales..."

# Verificar que la aplicación está en estado OK
if php artisan tinker --execute="echo 'OK'" &>/dev/null; then
    log_success "Aplicación Laravel funcionando correctamente"
else
    log_warning "No se pudo verificar el estado de la aplicación"
fi

# Mostrar información de la aplicación
APP_ENV=$(grep APP_ENV "$DEPLOYMENT_DIR/.env" | cut -d= -f2)
APP_DEBUG=$(grep APP_DEBUG "$DEPLOYMENT_DIR/.env" | cut -d= -f2)
log_success "Entorno: $APP_ENV"
log_success "Debug: $APP_DEBUG"

echo ""

# ============================================================================
# 14. RESUMEN FINAL
# ============================================================================

cat << "EOF"
╔════════════════════════════════════════════════════════════════════════════╗
║                                                                            ║
║                    ✅ DEPLOYMENT COMPLETADO EXITOSAMENTE ✅               ║
║                                                                            ║
╚════════════════════════════════════════════════════════════════════════════╝
EOF

echo ""
log_success "Deployment finalizado"
log_info "Timestamp: $(date)"
log_info "Logs disponibles en: $LOG_FILE"
log_info "Backup disponible en: $BACKUP_DIR"

echo ""

# Mostrar comandos útiles
cat << "EOF"
📋 COMANDOS ÚTILES POST-DEPLOYMENT:

   # Ver logs en tiempo real:
   tail -f storage/logs/laravel.log

   # Verificar estado de la aplicación:
   php artisan optimize:clear

   # Ejecutar comando artisan:
   php artisan [comando]

   # Ver migraciones pendientes:
   php artisan migrate:status

   # Revertir última migración:
   php artisan migrate:rollback

   # Ejecutar seeders:
   php artisan db:seed

EOF

echo ""

# ============================================================================
# EXITOSO
# ============================================================================

exit 0
